#!/bin/sh
#
# First-boot defaults for the 360T7 wired-AP image.
# Runs after /sbin/wifi config, so /etc/config/wireless already exists.
#
set -u

# Management address (also patched at build time for the initial config).
if uci -q get network.lan >/dev/null 2>&1; then
	uci set network.lan.ipaddr='192.168.5.1'
	uci -q delete network.lan.gateway || true
	uci -q delete network.lan.dns || true
	uci commit network
fi

# Open Wi-Fi network named immortalwrt-360t7 on both bands.
for s in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
	[ "$(uci -q get wireless.$s.mode)" = "ap" ] || continue
	uci set wireless.$s.ssid='immortalwrt-360t7'
	uci set wireless.$s.encryption='none'
	uci set wireless.$s.disabled='0'
	uci -q delete wireless.$s.key || true
done

for r in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\(radio[0-9]*\)=wifi-device$/\1/p'); do
	uci set wireless.$r.disabled='0'
	uci set wireless.$r.country='CN'
done

uci commit wireless

# DAWN is installed but must stay off until both APs are configured.
if [ -x /etc/init.d/dawn ]; then
	/etc/init.d/dawn disable 2>/dev/null || true
fi

exit 0
