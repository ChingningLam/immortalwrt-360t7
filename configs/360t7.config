# ImmortalWrt 25.12 for Qihoo 360T7 (MT7981B, Filogic 820)
#
# Target:  mediatek/filogic
# Devices: standard layout + UBI layout
# Driver:  mt76 (open source) + WED offload firmware
#
# Keep this file in sync with the workflow.

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_qihoo_360t7=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_qihoo_360t7-ubi=y

# LuCI and theme
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# Full wpad: required for 802.11r/k/v (FT, RRM, BTM)
CONFIG_PACKAGE_wpad-openssl=y

# Optional cross-AP steering daemon (service stays disabled by default)
CONFIG_PACKAGE_dawn=y
CONFIG_PACKAGE_luci-app-dawn=y
CONFIG_PACKAGE_luci-i18n-dawn-zh-cn=y

# Diagnostics
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_hostapd-utils=y
